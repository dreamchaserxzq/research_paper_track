  "concepts": [
    {
      "id": "num:wellposedness",
      "label": "连续问题的适定性",
      "summary": "先确定函数空间、边界条件、解的意义及数据扰动下的连续依赖。",
      "domain": "numerics"
    },
    {
      "id": "num:consistency_stability",
      "label": "一致性、稳定性与收敛",
      "summary": "一致性控制局部缺陷，稳定性控制传播；等价定理只在所述线性适定框架内使用。",
      "domain": "numerics"
    },
    {
      "id": "num:finite_difference",
      "label": "有限差分",
      "summary": "用局部差分近似导数，分析截断误差、数值色散、CFL及边界闭合。",
      "domain": "numerics"
    },
    {
      "id": "num:finite_volume",
      "label": "有限体积",
      "summary": "推进控制体平均，以相邻单元共享数值通量实现局部守恒。",
      "domain": "numerics"
    },
    {
      "id": "num:finite_element",
      "label": "有限元与变分逼近",
      "summary": "弱形式、有限维试验空间与离散稳定性共同决定近似质量。",
      "domain": "numerics"
    },
    {
      "id": "num:discontinuous_galerkin",
      "label": "间断Galerkin",
      "summary": "单元内高阶多项式与面通量/罚项结合；守恒、稳定和限制器需分别设计。",
      "domain": "numerics"
    },
    {
      "id": "num:spectral",
      "label": "谱与伪谱方法",
      "summary": "全局基表示适合可利用规则性的问题；光滑度、边界和混叠限制高阶收益。",
      "domain": "numerics"
    },
    {
      "id": "num:time_integration",
      "label": "时间离散",
      "summary": "空间离散后的ODE/DAE仍须设计精度、绝对稳定域、误差控制与求解容差。",
      "domain": "numerics"
    },
    {
      "id": "num:stiffness_imex",
      "label": "刚性与IMEX",
      "summary": "把快慢或刚性/非刚性作用分开；隐式部分仍需代数求解，显式部分仍有限制。",
      "domain": "numerics"
    },
    {
      "id": "num:symplectic",
      "label": "几何与辛积分",
      "summary": "对Hamilton结构保辛；长期近能量守恒需要步长、光滑性等条件，不等于每步精确保能。",
      "domain": "numerics"
    },
    {
      "id": "num:krylov",
      "label": "Krylov子空间",
      "summary": "在由残差和算子作用生成的空间内迭代求解；CG与GMRES的适用结构不同。",
      "domain": "numerics"
    },
    {
      "id": "num:preconditioning",
      "label": "预条件",
      "summary": "改变迭代问题的有效谱/几何，同时控制构建、应用和通信成本。",
      "domain": "numerics"
    },
    {
      "id": "num:multigrid",
      "label": "多重网格",
      "summary": "平滑器与粗空间分工处理误差；粗空间须捕捉平滑器难以消除的分量。",
      "domain": "numerics"
    },
    {
      "id": "num:domain_decomposition",
      "label": "区域分解",
      "summary": "局部求解与界面/粗空间耦合，使数学分解和并行分布协同。",
      "domain": "numerics"
    },
    {
      "id": "num:newton",
      "label": "非线性与Newton–Krylov",
      "summary": "线性化、全局化与不精确内层求解共同组成非线性算法。",
      "domain": "numerics"
    },
    {
      "id": "num:conservation_entropy",
      "label": "守恒、熵与物理解选择",
      "summary": "通量守恒控制账本；熵条件/耗散结构用于排除非物理弱解。",
      "domain": "numerics"
    },
    {
      "id": "num:mixed_inf_sup",
      "label": "混合形式与inf–sup",
      "summary": "速度压力等不同变量空间必须兼容；稳定常数不能随网格退化。",
      "domain": "numerics"
    },
    {
      "id": "num:compatible_feec",
      "label": "相容离散与FEEC",
      "summary": "通过离散复形和有界交换投影保存连续问题的微分结构。",
      "domain": "numerics"
    },
    {
      "id": "num:geometry_mesh",
      "label": "几何与网格",
      "summary": "几何映射、单元质量、边界近似和悬挂节点是误差与稳定性的一部分。",
      "domain": "numerics"
    },
    {
      "id": "num:amr",
      "label": "自适应网格与多层同步",
      "summary": "依据误差/物理指标局部细化；粗细通量、时间子循环和并行负载需一致。",
      "domain": "numerics"
    },
    {
      "id": "num:aposteriori_dwr",
      "label": "后验估计与目标导向适配",
      "summary": "计算后估计误差；用伴随敏感度给局部残差加权以控制目标泛函。",
      "domain": "numerics"
    },
    {
      "id": "num:multiscale_ap",
      "label": "多尺度与渐近保持",
      "summary": "固定离散尺度下，小物理参数极限应给出正确宏观离散；AP与统一高阶精度不同。",
      "domain": "numerics"
    },
    {
      "id": "num:inverse_adjoint",
      "label": "反问题、正则化与伴随",
      "summary": "从观测推断参数，需辨识性和先验；伴随控制多参数梯度的求解成本。",
      "domain": "numerics"
    },
    {
      "id": "num:uq",
      "label": "不确定性量化与多层采样",
      "summary": "分开输入不确定性、模型误差、离散偏差与采样方差。",
      "domain": "numerics"
    },
    {
      "id": "num:rom",
      "label": "降阶与投影",
      "summary": "离线构造低维空间，再投影动力学；快照压缩误差不等于在线演化误差。",
      "domain": "numerics"
    },
    {
      "id": "num:matrix_free_hpc",
      "label": "无矩阵算子与异构HPC",
      "summary": "以算子作用代替全矩阵存储，联合优化离散、预条件、数据布局与通信。",
      "domain": "numerics"
    },
    {
      "id": "num:optimal_test_spaces",
      "label": "最优测试空间与DPG",
      "summary": "给定试探空间，通过测试范数和局部Riesz问题构造稳定测试方向；近似空间仍需稳定性控制。",
      "domain": "numerics"
    },
    {
      "id": "num:spectral_coarse_spaces",
      "label": "谱粗空间与GenEO",
      "summary": "依据局部广义特征问题选择阻碍收敛的方向，经分片单位形成全局粗空间。",
      "domain": "numerics"
    },
    {
      "id": "num:parallel_in_time",
      "label": "时间并行与粗细传播",
      "summary": "把时间域分段，以串行粗传播和并行细传播迭代校正；收敛与加速取决于传播器和问题类型。",
      "domain": "numerics"
    }
  ],

  "concepts": [
    {
      "id": "ai:attention",
      "label": "注意力与可寻址上下文",
      "summary": "以内容相似度形成 token 交互；表征能力、长上下文开销和位置表示须联合评估。",
      "domain": "ai"
    },
    {
      "id": "ai:self_supervised_representation",
      "label": "自监督表征与任务充分性",
      "summary": "通过掩码预测、教师学生一致性等任务学习表示；全局语义与局部细节可能存在目标冲突。",
      "domain": "ai"
    },
    {
      "id": "ai:multimodal_alignment",
      "label": "跨模态对齐与条件接口",
      "summary": "从图文配对检索到任务条件化，将不同观测与语言嵌入建立可使用的对应关系。",
      "domain": "ai"
    },
    {
      "id": "ai:streaming_multimodal",
      "label": "流式多模态与时间对齐",
      "summary": "在异步采样、异速编码和增量生成下处理时间戳、信息到达顺序与首包延迟。",
      "domain": "ai"
    },
    {
      "id": "ai:diffusion",
      "label": "去噪扩散生成",
      "summary": "通过多噪声尺度的去噪学习逆向生成过程；质量、似然与采样成本不是同一指标。",
      "domain": "ai"
    },
    {
      "id": "ai:flow_matching",
      "label": "条件流匹配",
      "summary": "用可采样条件路径的速度监督学习概率流；训练无需模拟轨迹，生成仍需数值积分。",
      "domain": "ai"
    },
    {
      "id": "ai:latent_generative_models",
      "label": "潜空间生成与压缩",
      "summary": "先将高维观测压缩，再学习潜变量分布；压缩节省计算，同时限定可恢复的信息。",
      "domain": "ai"
    },
    {
      "id": "ai:selective_state_space",
      "label": "选择性状态空间与结构化序列计算",
      "summary": "输入依赖的状态更新控制有限记忆，结构化矩阵支持递推和并行分块算法。",
      "domain": "ai"
    },
    {
      "id": "ai:sparse_experts",
      "label": "稀疏专家与条件计算",
      "summary": "仅激活部分专家以扩大总容量；路由质量、负载均衡和通信决定有效成本。",
      "domain": "ai"
    },
    {
      "id": "ai:scaling_laws",
      "label": "经验缩放与资源分配",
      "summary": "在指定数据、优化器和预算下拟合性能随模型及数据规模的变化，不是普适常数。",
      "domain": "ai"
    },
    {
      "id": "ai:data_curation",
      "label": "数据筛选、混合与可追溯评估",
      "summary": "以受控训练比较数据干预；重复、标签偏差、覆盖与验证分布共同定义质量。",
      "domain": "ai"
    },
    {
      "id": "ai:generalization_theory",
      "label": "泛化、归纳偏置与插值",
      "summary": "区别拟合训练数据、同分布泛化与分布外可靠性；参数量本身不足以解释全部行为。",
      "domain": "ai"
    },
    {
      "id": "ai:hardware_aware_systems",
      "label": "硬件感知训练与推理系统",
      "summary": "利用存储层级、异步执行、通信重叠及混合精度改善实际计算，而非只比较 FLOPs。",
      "domain": "ai"
    },
    {
      "id": "ai:compression_and_memory",
      "label": "压缩、记忆与精度预算",
      "summary": "统一考察 KV 压缩、有限状态、潜空间、低精度的资源收益和信息误差。",
      "domain": "ai"
    },
    {
      "id": "ai:predictive_latents",
      "label": "预测式潜表征与JEPA",
      "summary": "通过上下文预测目标编码，在潜空间定义训练任务；必须另验下游所需信息是否保留。",
      "domain": "ai"
    },
    {
      "id": "ai:factorized_predictive_states",
      "label": "因子化预测状态",
      "summary": "把潜在目标拆成互补子空间，用多分支预测并合成；正交几何不等于物理机制可识别。",
      "domain": "ai"
    }
  ],
